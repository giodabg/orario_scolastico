<Window x:Class="OrarioClasse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orario di classe - Prototipo 1" Height="690" Width="940"
        MinWidth="760" MinHeight="550" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Orario di classe" FontSize="25" FontWeight="Bold"/>
            <TextBlock Text="Seleziona due celle e premi Scambia. Le lezioni non possono avere buchi." Foreground="DimGray" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <Button x:Name="ScambiaButton" Content="Scambia" Width="120" Height="38"
                        HorizontalAlignment="Right" DockPanel.Dock="Right" Click="Scambia_Click" IsEnabled="False"/>
                <TextBlock x:Name="SelezioneText" Text="Seleziona la prima cella." VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="EsitoText" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid x:Name="GrigliaOrario"/>
    </DockPanel>
</Window>
